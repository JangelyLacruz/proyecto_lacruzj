Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/chatbot-api [NC]
    RewriteRule ^ - [L]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^proyecto-lacruz-j/(.*)$ /$1 [PT,L]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^([a-zA-Z0-9/ñÑ_-]+)$ index.php?views=$1 [QSA,L]
</IfModule>